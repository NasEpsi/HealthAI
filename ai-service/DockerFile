FROM python:3.12-slim

WORKDIR /app

COPY pyproject.toml /app/pyproject.toml

RUN pip install --no-cache-dir -U pip \
    && pip install --no-cache-dir fastapi uvicorn pymongo pytest httpx pytest-cov python-multipart prometheus-fastapi-instrumentator
    
COPY src /app/src
COPY tests /app/tests

ENV PYTHONPATH=/app/src

CMD ["uvicorn", "healthai_ai.main:app", "--host", "0.0.0.0", "--port", "8000"]
