{
  "appId": "com.healthai.coach",
  "appName": "HealthAI Coach",
  "webDir": "dist",
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "backgroundColor": "#F8F5F0",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#F8F5F0"
    },
    "Camera": {
      "presentationStyle": "fullscreen"
    }
  }
}
