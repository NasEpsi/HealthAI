# URL de l'API backend (web local)
VITE_API_URL=http://localhost:8000
VITE_API_KEY=healthai

# Cloudinary (upload images, vidéos, avatars)
# Créez un compte sur https://cloudinary.com puis un upload preset "unsigned"
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# Émulateur Android : utiliser 10.0.2.2 au lieu de localhost
# VITE_API_URL=http://10.0.2.2:8000

# Appareil physique : IP de ton PC sur le réseau local
# VITE_API_URL=http://192.168.1.XX:8000
